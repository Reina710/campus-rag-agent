# 复制本文件为 .env，然后填入真实值。
#   cp .env.example .env     （Linux/Mac）
#   或手动复制改名为 .env   （Windows）
#
# .env 被 .gitignore 挡住，不会进仓库。真实密钥只放 .env，别提交。
# 完整的部署说明见 DEPLOY.md。

# ---------------- 必填 ----------------
# DeepSeek 对话模型（openai 兼容接口）
DEEPSEEK_KEY=在这里填你的DeepSeek密钥

# 阿里云 DashScope：向量（text-embedding-v3）+ rerank（gte-rerank-v2）
DASHSCOPE_KEY=在这里填你的阿里云DashScope密钥

# ---------------- 强烈建议填 ----------------
# cookie 签名密钥。不填则每次重启随机生成：重启后所有会话丢失，
# 多实例时互相验不过签名（用户会看到"随机掉历史"）。
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# ---------------- 可选 ----------------
PORT=8000

# 日志：1 = 一行一个 JSON（生产推荐，日志平台好解析）；0 = 人读格式
LOG_JSON=1
LOG_LEVEL=INFO

# 启动预热：把 jieba 词典和块向量成本挪到启动阶段，避免第一个访客等冷启动
WARMUP=1
# 是否在启动时也预热一次模型连接（会发一条极短的真实请求，花钱）
WARMUP_LLM=0

# 同时在跑的问答数上限。要小于 gunicorn 的 --threads，
# 留出线程给健康检查，否则探针会被长请求饿死、平台误判服务挂了。
MAX_CONCURRENT_ASKS=8

# 同一 IP 每分钟问答次数上限（每次问答都要花模型的钱）
RATE_LIMIT_PER_MIN=12

# 是否信任 X-Forwarded-For。默认 0：这个头客户端能自己伪造，
# 直接信它等于限流形同虚设。确认跑在反向代理后面再设 1。
TRUST_PROXY=0

# 只在 HTTPS 下发 cookie。由反向代理终结 TLS 后设 1；
# 本地 http 调试必须保持 0，否则浏览器不存 cookie。
COOKIE_SECURE=0
