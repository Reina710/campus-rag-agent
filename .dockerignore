# 不进镜像的东西

# 密钥绝不进镜像（运行时用 -e 或平台的环境变量注入）
.env

# 本地产物
__pycache__/
*.pyc
.pytest_cache/
reports/
index/
data/memory/
data/memory.json

# 编辑器
.idea/
.vscode/
.DS_Store

# 本地调试日志
_*.log

# 前端：源码进构建阶段，依赖和产物不进镜像（镜像里重新 npm ci + build）
frontend/node_modules/
static/

# 版本控制与容器自身
.git/
.gitignore
Dockerfile
.dockerignore
