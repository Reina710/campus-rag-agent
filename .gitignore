# 密钥 —— 绝不进仓库
.env

# Python 缓存
__pycache__/
*.pyc

# 评测报告（本地全量产物不进仓库，只保留最终三份原始输出）
reports/*
!reports/final/
!reports/final/*
# 会话记忆（本地产物）
data/memory.json
data/memory/

# 上传文档（运行时数据，clone 后只有内置 knowledge.md）
data/uploads/

# 用户反馈（运行时数据）
data/feedback.jsonl

# bad case 池报告（由 experiments/harvest_feedback.py 生成）
data/bad_cases.md

# 测试缓存
tests/__pycache__/

# 向量索引（体积大，能从知识库重新生成，不进仓库）
index/

# 编辑器/系统
.vscode/
.idea/
.DS_Store

# 前端：依赖与构建产物都不入库，clone 后跑 npm ci && npm run build 生成
frontend/node_modules/
static/

# 本地调试产生的临时文件
_*.log
_*.txt
_*.png

# 个人面试准备材料，不进公开仓库
docs/面试讲稿.md
